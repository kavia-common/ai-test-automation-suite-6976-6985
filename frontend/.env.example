# Frontend environment variables (Create React App conventions)
# Copy to .env and adjust values as needed.

# API base URL (preferred). Example: https://your-backend.example.com/api
REACT_APP_API_BASE=

# Backend base URL (fallback if REACT_APP_API_BASE is not set). Example: https://your-backend.example.com
REACT_APP_BACKEND_URL=

# WebSocket URL. Set to explicit ws(s) URL or leave empty to derive from BACKEND_URL.
# Set to "disabled" to turn off WebSocket features.
REACT_APP_WS_URL=

# Healthcheck path appended to API base. Default: /health
REACT_APP_HEALTHCHECK_PATH=/health

# Feature flags as comma/space separated list. Examples:
# "aiAuthoring, liveRuns=true, debug=false"
REACT_APP_FEATURE_FLAGS=
