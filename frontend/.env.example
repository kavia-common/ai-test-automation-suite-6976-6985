# Frontend environment variables (Create React App style)

# REST base URL. Default fallback: http://localhost:3001
REACT_APP_API_BASE=http://localhost:3001

# Optional generic backend root (used if API_BASE not set)
# REACT_APP_BACKEND_URL=http://localhost:3001

# WebSocket URL. If omitted, it will fallback to ws://localhost:3001/ws.
# Set to "disabled" to explicitly disable WebSocket.
# REACT_APP_WS_URL=ws://localhost:3001/ws

# Healthcheck path. Defaults to "/".
# REACT_APP_HEALTHCHECK_PATH=/

# Feature flags (comma/space separated, support key or key=value)
# Example: "WS=true EXPERIMENTS_ENABLED=true"
# REACT_APP_FEATURE_FLAGS=WS=true,EXPERIMENTS_ENABLED=true

# Explicit experiments toggle (merged into flags as EXPERIMENTS_ENABLED)
# REACT_APP_EXPERIMENTS_ENABLED=true

# Optional UI / telemetry toggles
# REACT_APP_NODE_ENV=development
# REACT_APP_NEXT_TELEMETRY_DISABLED=1
# REACT_APP_ENABLE_SOURCE_MAPS=true
# REACT_APP_PORT=3000
# REACT_APP_TRUST_PROXY=true
# REACT_APP_LOG_LEVEL=info
